# Firebase web configuration.
#
# These values are public by design: they identify the project to Firebase and
# are visible in any browser's network tab. Access control lives in
# firestore.rules and App Check, not here. They are committed so a fresh clone
# runs with no setup; copy this file to .env.local to point at another project.

VITE_FIREBASE_API_KEY=AIzaSyCXPy7JK5KrtTB30vwH5IPusE_SmGZVhAw
VITE_FIREBASE_AUTH_DOMAIN=golist-v2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=golist-v2
VITE_FIREBASE_STORAGE_BUCKET=golist-v2.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=429198896031
VITE_FIREBASE_APP_ID=1:429198896031:web:eb5c6b33b3fbc512ac6baa
VITE_FIREBASE_MEASUREMENT_ID=G-HLPL8XFWPS

# reCAPTCHA v3 site key backing App Check. Also public.
VITE_RECAPTCHA_SITE_KEY=6LcjdWEgAAAAALv8OzKlJgNklv2kpL4iAXFNuRuZ

# Intercom workspace id. Leave blank to disable the messenger entirely.
VITE_INTERCOM_APP_ID=od46lrxi

# Set to "true" to run against the local Firebase emulator suite instead of
# production. `npm run dev:emulated` does this for you.
VITE_USE_EMULATORS=false
